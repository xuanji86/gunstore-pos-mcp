# GunStore-POS MCP — Frappe REST credentials.
# Copy to .env (git-ignored) and fill in. Generate keys in Desk:
#   Administrator → top-right avatar → My Settings → API Access → Generate Keys
#
# Point at dev first for testing, then switch to prod:
#   dev : http://dev.localhost:8000
#   prod: https://pos.oldsteelarsenal.com

FRAPPE_BASE_URL=http://dev.localhost:8000
FRAPPE_API_KEY=
FRAPPE_API_SECRET=

# Optional ---------------------------------------------------------------
# Request timeout (seconds)
FRAPPE_TIMEOUT=30

# Doctypes blocked from writes (comma-separated). Unset = the safe default
# below (schema/permission doctypes — change those in Desk/code, not here).
# FRAPPE_WRITE_DENYLIST=DocType,Custom Field,Property Setter,Server Script,Client Script,Role,DocPerm,Custom DocPerm,User
